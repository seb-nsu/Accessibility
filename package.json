{
  "name": "a11y-supertest",
  "version": "0.1.0",
  "private": true,
  "description": "Barrierefreiheits-Supertest: WCAG 2.2 AA / EN 301 549 für Quellcode und Live-Websites",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "playwright test",
    "test:axe": "playwright test tests/01-axe.spec.ts",
    "test:tastatur": "playwright test tests/02-tastatur.spec.ts",
    "test:ohne-snapshots": "playwright test --grep-invert \"ARIA-Snapshot\"",
    "report": "node scripts/report.ts",
    "supertest": "playwright test; node scripts/report.ts",
    "selbsttest": "A11Y_PAGES=/kaputt.html playwright test --grep-invert \"ARIA-Snapshot\"; node scripts/report.ts",
    "snapshots:update": "playwright test tests/05-aria-snapshot.spec.ts --update-snapshots",
    "demo": "node scripts/serve-demo.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
